class PatchError(Exception):
    pass


@dataclass(frozen=True)
class Context:
    steam: Path
    library: Path
    game: Path
    prefix: Path
    map_file: Path
    registry: Path
    config: Path
    state: Path


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def file_sha(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def atomic_write(path: Path, data: bytes, *, mode_from: Path | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if mode_from and mode_from.exists():
            shutil.copymode(mode_from, temporary)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def vdf_string(text: str, key: str) -> str | None:
    match = re.search(r'(?m)^\s*"' + re.escape(key) + r'"\s*"([^"\r\n]*)"', text)
    return match.group(1) if match else None


def steam_roots(explicit: Path | None):
    home = Path.home()
    candidates = [explicit] if explicit else [
        Path(os.environ["STEAM_DIR"]) if os.environ.get("STEAM_DIR") else None,
        home / ".steam/steam", home / ".local/share/Steam",
        home / ".var/app/com.valvesoftware.Steam/.local/share/Steam",
    ]
    seen = set()
    for candidate in candidates:
        if candidate is None or not candidate.exists():
            continue
        root = candidate.resolve()
        if root not in seen and (root / "steamapps").is_dir():
            seen.add(root)
            yield root


def discover(explicit_steam: Path | None = None) -> Context:
    found = []
    for steam in steam_roots(explicit_steam):
        libraries = [steam]
        folders = steam / "steamapps/libraryfolders.vdf"
        if folders.exists():
            for value in re.findall(r'(?m)^\s*"path"\s*"([^"\r\n]+)"', folders.read_text(errors="replace")):
                path = Path(value).expanduser().resolve()
                if path not in libraries:
                    libraries.append(path)
        for library in libraries:
            manifest = library / f"steamapps/appmanifest_{APPID}.acf"
            if not manifest.is_file():
                continue
            install_dir = vdf_string(manifest.read_text(errors="replace"), "installdir")
            if not install_dir:
                raise PatchError(f"Missing installdir in {manifest}")
            common = (library / "steamapps/common").resolve()
            game = (common / install_dir).resolve()
            if common not in game.parents or not (game / "OVERSEER.EXE").is_file():
                raise PatchError(f"Unexpected game directory from {manifest}: {game}")
            prefix = library / f"steamapps/compatdata/{APPID}/pfx"
            if not (prefix / "user.reg").is_file():
                raise PatchError(f"Steam manifest found, but prefix is missing: {prefix}")
            found.append(Context(steam, library, game, prefix,
                                 game / "DATA/R01/R01.MAP", prefix / "user.reg",
                                 steam / "config/config.vdf",
                                 library / f"steamapps/compatdata/{APPID}/overseer-patcher"))
    unique = {(ctx.game, ctx.prefix): ctx for ctx in found}
    if len(unique) != 1:
        raise PatchError(f"Expected one Steam Overseer installation; found {len(unique)}. Use --steam-root if needed.")
    return next(iter(unique.values()))


def patch_map(original: bytes) -> bytes:
    if sha(original) != ORIGINAL_MAP_SHA:
        raise PatchError("R01.MAP is not the tested original build")
    data = bytearray(original)
    if len(data) != int.from_bytes(data[0:4], "little") or int.from_bytes(data[8:12], "little") != 331:
        raise PatchError("Unexpected office map structure")
    metadata = int.from_bytes(data[12:16], "little")
    changed = 0
    for texture, indices in PALETTE_INDICES.items():
        entry = metadata + 36 * texture
        width = int.from_bytes(data[entry:entry + 4], "little")
        height = int.from_bytes(data[entry + 4:entry + 8], "little")
        depth = int.from_bytes(data[entry + 8:entry + 12], "little")
        palette = int.from_bytes(data[entry + 28:entry + 32], "little")
        pixels = int.from_bytes(data[entry + 32:entry + 36], "little")
        if not width or not height or depth != 8 or pixels - palette != 1024:
            raise PatchError(f"Unexpected texture metadata for entry {texture}")
        for index in indices:
            offset = palette + 4 * index
            color = data[offset:offset + 3]
            if len(color) != 3 or max(color) >= 8:
                raise PatchError(f"Unexpected palette value in entry {texture}, index {index}")
            changed += sum(component != 8 for component in color)
            data[offset:offset + 3] = b"\x08\x08\x08"
    if changed != 228 or sha(data) != PATCHED_MAP_SHA:
        raise PatchError("Computed texture patch failed byte-for-byte verification")
    return bytes(data)


def registry_value(text: str) -> str | None:
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines)
                  if line == REG_SECTION or line.startswith(REG_SECTION + " ")), None)
    if start is None:
        return None
    for line in lines[start + 1:]:
        if line.startswith("["):
            break
        match = re.fullmatch(r'"VideoMemorySize"="([^"\r\n]*)"', line)
        if match:
            return match.group(1)
    return None


def edit_registry(text: str, value: str | None) -> str:
    newline = "\r\n" if "\r\n" in text else "\n"
    lines = text.splitlines(keepends=True)
    start = next((i for i, line in enumerate(lines)
                  if line.rstrip("\r\n") == REG_SECTION
                  or line.rstrip("\r\n").startswith(REG_SECTION + " ")), None)
    if start is None:
        if value is None:
            return text
        return text.rstrip("\r\n") + newline + newline + REG_SECTION + newline + f'{REG_KEY}="{value}"' + newline
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    key_line = next((i for i in range(start + 1, end) if lines[i].startswith(REG_KEY + "=")), None)
    if key_line is not None:
        if value is None:
            del lines[key_line]
        else:
            lines[key_line] = f'{REG_KEY}="{value}"' + newline
    elif value is not None:
        lines.insert(end, f'{REG_KEY}="{value}"' + newline)
    return "".join(lines)


def find_vdf_block(text: str, key: str, start: int = 0, end: int | None = None):
    end = len(text) if end is None else end
    pattern = re.compile(r'(?m)^[ \t]*"' + re.escape(key) + r'"[ \t\r\n]*\{')
    match = pattern.search(text, start, end)
    if not match:
        return None
    open_brace = text.rfind("{", match.start(), match.end())
    depth = 0
    quoted = False
    escaped = False
    comment = False
    index = open_brace
    while index < end:
        char = text[index]
        if comment:
            if char == "\n":
                comment = False
        elif quoted:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                quoted = False
        elif text.startswith("//", index):
            comment = True
            index += 1
        elif char == '"':
            quoted = True
        elif char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return match.start(), open_brace, index
        index += 1
    raise PatchError(f"Unclosed VDF block {key}")


def app_mapping(text: str) -> tuple[str | None, tuple[int, int] | None, tuple[int, int, int]]:
    mapping = find_vdf_block(text, "CompatToolMapping")
    if mapping is None:
        raise PatchError("Steam config has no CompatToolMapping block")
    app = find_vdf_block(text, APPID, mapping[1] + 1, mapping[2])
    if app is None:
        return None, None, mapping
    raw = text[app[0]:app[2] + 1]
    return vdf_string(raw, "name"), (app[0], app[2] + 1), mapping


def edit_mapping(text: str, tool_id: str | None, restore_raw: str | None = None) -> str:
    current_name, span, mapping = app_mapping(text)
    if tool_id is None and restore_raw is None:
        if span is None:
            return text
        line_end = text.find("\n", span[1])
        end = line_end + 1 if line_end >= 0 else span[1]
        return text[:span[0]] + text[end:]
    if restore_raw is not None:
        replacement = restore_raw
    else:
        close_line_start = text.rfind("\n", 0, mapping[2]) + 1
        close_indent = re.match(r"[ \t]*", text[close_line_start:mapping[2]]).group(0)
        indent = close_indent + "\t"
        replacement = (f'{indent}"{APPID}"\n{indent}{{\n'
                       f'{indent}\t"name"\t\t"{tool_id}"\n'
                       f'{indent}\t"config"\t\t""\n'
                       f'{indent}\t"priority"\t\t"250"\n'
                       f'{indent}}}')
    if span is not None:
        return text[:span[0]] + replacement + text[span[1]:]
    insert = text.rfind("\n", 0, mapping[2]) + 1
    return text[:insert] + replacement + "\n" + text[insert:]


def steam_running() -> bool:
    proc = Path("/proc")
    try:
        for entry in proc.iterdir():
            if not entry.name.isdigit():
                continue
            try:
                name = (entry / "comm").read_text().strip().lower()
            except (OSError, UnicodeError):
                continue
            if name in {"steam", "steamwebhelper", "overseer.exe"}:
                return True
    except OSError:
        pass
    return False


def tool_id_from_manifest(path: Path) -> str | None:
    if not path.is_file():
        return None
    text = path.read_text(errors="replace")
    match = re.search(r'"compat_tools"\s*\{\s*"([^"]+)"', text)
    return match.group(1) if match else None


def proton_candidates(steam: Path):
    dirs = [steam / "compatibilitytools.d", Path("/usr/share/steam/compatibilitytools.d")]
    for parent in dirs:
        if not parent.is_dir():
            continue
        for tool in parent.iterdir():
            if not tool.is_dir() or not (tool / "proton").is_file():
                continue
            version = tool / "version"
            if version.is_file() and RELEASE_TAG in version.read_text(errors="replace"):
                yield tool


def choose_proton(steam: Path) -> Path:
    candidates = list(proton_candidates(steam))
    if not candidates:
        raise PatchError("Tested Proton-CachyOS release is missing. Run install-proton first.")
    return sorted(candidates, key=lambda p: (
        p.name != "Proton-CachyOS Latest-x86_64_v3",
        p.name != f"Overseer-Proton-CachyOS-{RELEASE_TAG}",
        str(p),
    ))[0]


def alias_path(steam: Path) -> Path:
    return steam / "compatibilitytools.d" / f"Overseer-Proton-CachyOS-{RELEASE_TAG}"


def create_alias(steam: Path, source: Path) -> tuple[Path, bool]:
    alias = alias_path(steam)
    marker = alias / ".overseer-patcher-source"
    source = source.resolve()
    if alias.exists():
        if marker.is_file() and marker.read_text().strip() == str(source):
            return alias, False
        raise PatchError(f"Compatibility-tool alias already exists and is not ours: {alias}")
    alias.mkdir(parents=True)
    try:
        for child in source.iterdir():
            if child.name == "compatibilitytool.vdf":
                continue
            (alias / child.name).symlink_to(child)
        manifest = (f'"compatibilitytools"\n{{\n  "compat_tools"\n  {{\n'
                    f'    "{TOOL_ID}"\n    {{\n      "install_path" "."\n'
                    f'      "display_name" "Overseer Proton-CachyOS {RELEASE_TAG}"\n'
                    '      "from_oslist" "windows"\n      "to_oslist" "linux"\n'
                    '    }\n  }\n}\n')
        (alias / "compatibilitytool.vdf").write_text(manifest)
        marker.write_text(str(source) + "\n")
        if tool_id_from_manifest(alias / "compatibilitytool.vdf") != TOOL_ID:
            raise PatchError("Failed to create unique Proton tool manifest")
        return alias, True
    except Exception:
        remove_alias(alias, source)
        raise


def remove_alias(alias: Path, expected_source: Path) -> None:
    marker = alias / ".overseer-patcher-source"
    if not alias.exists():
        return
    if not marker.is_file() or marker.read_text().strip() != str(expected_source.resolve()):
        raise PatchError(f"Refusing to remove modified alias: {alias}")
    for child in alias.iterdir():
        if child.name in {"compatibilitytool.vdf", ".overseer-patcher-source"} and child.is_file():
            child.unlink()
        elif child.is_symlink() and child.resolve().parent == expected_source.resolve():
            child.unlink()
        else:
            raise PatchError(f"Refusing to remove unexpected alias content: {child}")
    alias.rmdir()


def release_assets() -> tuple[str, str, str | None]:
    url = f"https://api.github.com/repos/CachyOS/proton-cachyos/releases/tags/{RELEASE_TAG}"
    request = urllib.request.Request(url, headers={"User-Agent": "overseer-patcher/1.0", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(request, timeout=30) as response:
        release = json.load(response)
    if release.get("tag_name") != RELEASE_TAG:
        raise PatchError("GitHub returned an unexpected release")
    names = release.get("assets", [])
    cpu = Path("/proc/cpuinfo").read_text(errors="replace") if Path("/proc/cpuinfo").exists() else ""
    suffixes = ["x86_64_v3.tar.xz", "x86_64.tar.xz"] if "avx2" in cpu else ["x86_64.tar.xz"]
    asset = next((a for suffix in suffixes for a in names
                  if a.get("name", "").endswith(suffix) and "cachyos" in a.get("name", "").lower()), None)
    if not asset:
        raise PatchError("No suitable x86_64 release archive found")
    digest = asset.get("digest")
    checksum = next((a for a in names if a.get("name") == asset["name"] + ".sha512sum"), None)
    if not digest and not checksum:
        raise PatchError("Release has no verifiable archive digest")
    return asset["browser_download_url"], digest or "", checksum["browser_download_url"] if checksum else None


def install_proton(steam: Path) -> Path:
    # Network download is optional and runs only when this exact release is absent.
    try:
        return choose_proton(steam)
    except PatchError:
        pass
    if not hasattr(tarfile, "data_filter"):
        raise PatchError("Python's tarfile lacks safe extraction filters; use an updated Python 3 or install the pinned Proton release manually")
    archive_url, expected_digest, checksum_url = release_assets()
    parent = steam / "compatibilitytools.d"
    parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="overseer-proton-", dir=parent) as staging_name:
        staging = Path(staging_name)
        archive = staging / "proton.tar.xz"
        with urllib.request.urlopen(urllib.request.Request(archive_url, headers={"User-Agent": "overseer-patcher/1.0"}), timeout=60) as response, archive.open("wb") as stream:
            shutil.copyfileobj(response, stream)
        if expected_digest:
            algorithm, _, hexdigest = expected_digest.partition(":")
            if algorithm != "sha256" or file_sha(archive) != hexdigest:
                raise PatchError("Downloaded Proton archive digest mismatch")
        elif checksum_url:
            with urllib.request.urlopen(checksum_url, timeout=30) as response:
                checksum_text = response.read().decode("utf-8")
            expected_sha512 = checksum_text.split()[0]
            h = hashlib.sha512()
            with archive.open("rb") as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    h.update(chunk)
            if h.hexdigest() != expected_sha512:
                raise PatchError("Downloaded Proton archive SHA512 mismatch")
        extracted = staging / "extracted"
        extracted.mkdir()
        with tarfile.open(archive, "r:xz") as bundle:
            bundle.extractall(extracted, filter="data")
        roots = [p for p in [extracted, *extracted.iterdir()] if (p / "proton").is_file() and (p / "compatibilitytool.vdf").is_file()]
        if len(roots) != 1 or RELEASE_TAG not in (roots[0] / "version").read_text(errors="replace"):
            raise PatchError("Downloaded archive has an unexpected Proton layout/version")
        target = parent / f"Overseer-Downloaded-{RELEASE_TAG}"
        if target.exists():
            raise PatchError(f"Refusing to overwrite {target}")
        shutil.move(str(roots[0]), str(target))
        return target


def read_journal(ctx: Context) -> dict | None:
    path = ctx.state / "journal.json"
    return json.loads(path.read_text()) if path.exists() else None


def save_journal(ctx: Context, data: dict) -> None:
    ctx.state.mkdir(parents=True, exist_ok=True)
    atomic_write(ctx.state / "journal.json", (json.dumps(data, indent=2) + "\n").encode(), mode_from=ctx.state / "journal.json")


def verify_context(ctx: Context) -> tuple[str, str | None, str | None]:
    if not ctx.map_file.is_file() or not ctx.config.is_file():
        raise PatchError("Expected game map or Steam config is missing")
    if file_sha(ctx.game / "OVERSEER.EXE") != ORIGINAL_EXE_SHA:
        raise PatchError("OVERSEER.EXE differs from the tested original; no change made")
    map_sha = file_sha(ctx.map_file)
    if map_sha not in {ORIGINAL_MAP_SHA, PATCHED_MAP_SHA}:
        raise PatchError("R01.MAP differs from the tested original and patch; no change made")
    reg_text = ctx.registry.read_text(errors="surrogateescape")
    config_text = ctx.config.read_text(errors="surrogateescape")
    return map_sha, registry_value(reg_text), app_mapping(config_text)[0]


def status(ctx: Context) -> None:
    map_sha, vram, mapping = verify_context(ctx)
    print(f"Steam root: {ctx.steam}")
    print(f"Game: {ctx.game}")
    print(f"Prefix: {ctx.prefix}")
    print(f"Textures: {'patched' if map_sha == PATCHED_MAP_SHA else 'original'}")
    print(f"VideoMemorySize: {vram or 'unset'}")
    print(f"Steam per-game Proton: {mapping or 'unset (uses global default)'}")
    try:
        source = choose_proton(ctx.steam)
        print(f"Tested Proton source: {source}")
        ids = [tool_id_from_manifest(p / 'compatibilitytool.vdf') for p in proton_candidates(ctx.steam)]
        if len(ids) != len(set(ids)):
            print("Note: installed Proton tools share an internal ID; apply creates a unique game-specific alias.")
    except PatchError as error:
        print(f"Tested Proton source: missing ({error})")
    journal = read_journal(ctx)
    print(f"Patcher journal: {'present' if journal else 'absent'}")


def plan(ctx: Context, include_status: bool = True) -> None:
    if include_status:
        status(ctx)
    print("Apply will set VideoMemorySize=128 only in this prefix and patch 228 office palette bytes as needed.")
    print(f"It will use {RELEASE_TAG}, downloading and verifying the release if absent,")
    print(f"then map App ID {APPID} to a unique alias of that tool.")
    print("Steam and Overseer must be closed. No global compatibility setting is changed.")


def apply(ctx: Context) -> None:
    if steam_running():
        raise PatchError("Close Steam and Overseer before applying; Steam can overwrite config.vdf while running")
    map_sha, vram, mapping = verify_context(ctx)
    if vram not in {None, "128"}:
        raise PatchError(f"Unexpected existing VideoMemorySize={vram}; no change made")
    source = install_proton(ctx.steam)
    alias = alias_path(ctx.steam)
    existing = read_journal(ctx)
    if existing and existing.get("state") == "applied":
        if map_sha == PATCHED_MAP_SHA and vram == "128" and mapping == TOOL_ID:
            print("Already applied")
            return
        raise PatchError("Journal says applied but configuration differs; inspect status before proceeding")
    if existing:
        raise PatchError("Incomplete prior journal exists; inspect it before proceeding")
    original_map = ctx.map_file.read_bytes() if map_sha == ORIGINAL_MAP_SHA else None
    patched_map = patch_map(original_map) if original_map else None
    registry_before = ctx.registry.read_bytes()
    config_before = ctx.config.read_bytes()
    reg_text = registry_before.decode("utf-8", "surrogateescape")
    config_text = config_before.decode("utf-8", "surrogateescape")
    old_name, old_span, _ = app_mapping(config_text)
    old_entry = config_text[old_span[0]:old_span[1]] if old_span else None
    ctx.state.mkdir(parents=True, exist_ok=True)
    if not (ctx.state / "user.reg.before").exists():
        shutil.copy2(ctx.registry, ctx.state / "user.reg.before")
    if not (ctx.state / "config.vdf.before").exists():
        shutil.copy2(ctx.config, ctx.state / "config.vdf.before")
    if original_map and not (ctx.state / "R01.MAP.before").exists():
        shutil.copy2(ctx.map_file, ctx.state / "R01.MAP.before")
    journal = {
        "schema": 1, "state": "prepared", "steam": str(ctx.steam), "game": str(ctx.game),
        "source_proton": str(source.resolve()), "alias": str(alias),
        "alias_created": not alias.exists(),
        "original_map_sha": map_sha, "original_vram": vram,
        "original_mapping_name": old_name, "original_mapping_entry": old_entry,
        "original_registry_sha": sha(registry_before), "original_config_sha": sha(config_before),
    }
    save_journal(ctx, journal)
    try:
        create_alias(ctx.steam, source)
        if original_map:
            atomic_write(ctx.map_file, patched_map, mode_from=ctx.map_file)
        if vram is None:
            result = edit_registry(reg_text, "128").encode("utf-8", "surrogateescape")
            atomic_write(ctx.registry, result, mode_from=ctx.registry)
        if mapping != TOOL_ID:
            result = edit_mapping(config_text, TOOL_ID).encode("utf-8", "surrogateescape")
            atomic_write(ctx.config, result, mode_from=ctx.config)
        if verify_context(ctx) != (PATCHED_MAP_SHA, "128", TOOL_ID):
            raise PatchError("Post-apply verification failed")
        journal["state"] = "applied"
        save_journal(ctx, journal)
    except Exception:
        print("Apply stopped. Run 'revert' to restore changes recorded in the journal.", file=sys.stderr)
        raise
    print("Applied texture, prefix VRAM, and per-game Proton settings.")
    print("Restart Steam so it discovers the unique Proton-CachyOS alias.")
    print(f"Backup and journal: {ctx.state}")


def revert(ctx: Context) -> None:
    if steam_running():
        raise PatchError("Close Steam and Overseer before reverting")
    journal = read_journal(ctx)
    if not journal:
        raise PatchError("No patcher journal found; nothing owned by this patcher to revert")
    if journal.get("game") != str(ctx.game) or journal.get("steam") != str(ctx.steam):
        raise PatchError("Journal refers to a different Steam installation")
    map_sha, vram, mapping = verify_context(ctx)
    if map_sha not in {journal["original_map_sha"], PATCHED_MAP_SHA}:
        raise PatchError("Map changed since apply; refusing to overwrite")
    if vram not in {journal["original_vram"], "128"}:
        raise PatchError("Registry value changed since apply; refusing to overwrite")
    if mapping not in {journal["original_mapping_name"], TOOL_ID}:
        raise PatchError("Steam compatibility mapping changed since apply; refusing to overwrite")
    if journal["original_map_sha"] == ORIGINAL_MAP_SHA and map_sha == PATCHED_MAP_SHA:
        original = (ctx.state / "R01.MAP.before").read_bytes()
        if sha(original) != ORIGINAL_MAP_SHA:
            raise PatchError("Map backup failed verification")
        atomic_write(ctx.map_file, original, mode_from=ctx.map_file)
    elif map_sha != journal["original_map_sha"]:
        raise PatchError("Map changed since apply; refusing to overwrite")
    if journal["original_vram"] is None and vram == "128":
        original_registry = (ctx.state / "user.reg.before").read_bytes()
        if sha(original_registry) != journal["original_registry_sha"]:
            raise PatchError("Registry backup failed verification")
        expected = edit_registry(original_registry.decode("utf-8", "surrogateescape"), "128").encode("utf-8", "surrogateescape")
        if file_sha(ctx.registry) == sha(expected):
            atomic_write(ctx.registry, original_registry, mode_from=ctx.registry)
        else:
            reg_text = ctx.registry.read_text(errors="surrogateescape")
            atomic_write(ctx.registry, edit_registry(reg_text, None).encode("utf-8", "surrogateescape"), mode_from=ctx.registry)
    elif vram != journal["original_vram"]:
        raise PatchError("Registry value changed since apply; refusing to overwrite")
    if mapping == TOOL_ID and journal["original_mapping_name"] != TOOL_ID:
        config_text = ctx.config.read_text(errors="surrogateescape")
        original_entry = journal["original_mapping_entry"]
        restored = edit_mapping(config_text, None, restore_raw=original_entry) if original_entry else edit_mapping(config_text, None)
        atomic_write(ctx.config, restored.encode("utf-8", "surrogateescape"), mode_from=ctx.config)
    elif mapping != journal["original_mapping_name"]:
        raise PatchError("Steam compatibility mapping changed since apply; refusing to overwrite")
    if journal["alias_created"]:
        remove_alias(Path(journal["alias"]), Path(journal["source_proton"]))
    (ctx.state / "journal.json").unlink()
    print("Restored the pre-patcher map, registry value, and Steam per-game mapping.")
    print("Restart Steam to reload compatibility tools.")


def confirm_step(description: str) -> bool:
    try:
        response = input(f"{description} [y/N]: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    return response in {"y", "yes"}


def main() -> int:
    parser = argparse.ArgumentParser(description=DESCRIPTION)
    parser.add_argument("command", nargs="?", choices=["status", "plan", "apply", "revert", "install-proton"],
                        help="omit for the guided status → plan → apply workflow")
    parser.add_argument("--steam-root", type=Path, help="Steam root when autodetection is ambiguous")
    args = parser.parse_args()
    try:
        ctx = discover(args.steam_root)
        if args.command is None:
            for description, action in (
                ("Show installation status?", lambda: status(ctx)),
                ("Show proposed changes?", lambda: plan(ctx, include_status=False)),
                ("Apply these changes? Close Steam and Overseer first.", lambda: apply(ctx)),
            ):
                if not confirm_step(description):
                    print("Stopped without running the remaining steps.")
                    break
                action()
        elif args.command == "status":
            status(ctx)
        elif args.command == "plan":
            plan(ctx)
        elif args.command == "apply":
            apply(ctx)
        elif args.command == "revert":
            revert(ctx)
        else:
            if steam_running():
                raise PatchError("Close Steam before installing a compatibility tool")
            source = install_proton(ctx.steam)
            print(f"Tested release available: {source}")
            print("Restart Steam before selecting a newly downloaded tool.")
        return 0
    except (PatchError, OSError, ValueError, KeyError) as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
